# Copie para .env e preencha:  cp .env.example .env

# ---------- Coinos ----------
# Token da conta Coinos dedicada ao pote (coinos.io > Settings > API / Auth token).
# Deixe vazio para rodar só o gerador, sem recompensas nem doações.
COINOS_TOKEN=
# Endereço que aparece para doações (o da mesma conta), ex.: seuusuario@coinos.io
DONATION_LN_ADDRESS=

# ---------- Site ----------
# Endereço público do site, usado no texto de compartilhamento
PUBLIC_URL=https://exemplo.com.br
# 1 se estiver atrás de um proxy (Caddy/Traefik/Nginx), para ler o IP real do visitante.
# O X-Forwarded-For só é lido quando a conexão vem de um dos TRUSTED_PROXIES abaixo.
TRUST_PROXY=1
# De onde o proxy se conecta ao container (padrão: localhost + rede do Docker).
# Se o proxy roda em outra máquina, coloque o IP dela aqui.
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# Segredo que o proxy manda no cabeçalho X-Proxy-Secret (veja o Caddyfile no README).
# Sem ele o X-Forwarded-For é ignorado, mesmo vindo de um TRUSTED_PROXIES.
# Obrigatório com TRUST_PROXY=1 (o servidor não inicia sem ele). Gere com: openssl rand -hex 32
# Com Cloudflare Tunnel, o Cloudflare precisa mandar este cabeçalho (Transform Rule; veja o README),
# senão todos os visitantes contam como um só IP.
PROXY_SECRET=

# ---------- Página ----------
# Link do repositório no GitHub (ícone no topo da página). Vazio = ícone aparece como "em breve".
REPO_URL=
# Bug bounty: e-mail de contato e quanto do que for pego o atacante pode ficar
BOUNTY_EMAIL=sandmann@sandlabs.store
BOUNTY_PERCENT=70
# Botão "Reportar problema": cada relato chega como mensagem de um bot do Telegram.
# Deixe vazio para esconder o botão. Veja "Reportar problema" no README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# máximo de relatos por hora no site todo (cada pessoa já fica limitada a 3 a cada 10 min)
REPORTS_PER_HOUR=30
# Alerta no Telegram (mesmo bot acima) quando o pote cai abaixo deste valor em sats; 0 desliga.
# Repete no máximo a cada ALERTA_POTE_HORAS horas e avisa quando o pote voltar acima do limite.
ALERTA_POTE_SATS=500
ALERTA_POTE_HORAS=6

# ---------- Painel admin ----------
# Token de acesso a /admin (12+ caracteres). Vazio = o painel não existe (404).
# Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# Urna de brincadeira em /urna: vote '13 ou '22 e receba esse tanto de sats (precisa de
# COINOS_TOKEN para pagar; sem ele só vota). Um voto por pessoa; o placar só aparece depois
# de votar. URNA_DAILY_GLOBAL_SATS é o teto de sats da urna por dia, separado do DAILY_GLOBAL_SATS.
# URNA_DAILY_GLOBAL_SATS=0 tira o limite por dia; aí só URNA_POT_RESERVE_SATS segura o pote
# (a urna para de pagar quando o saldo chega nela). Sem ela, vale o POT_RESERVE_SATS.
URNA_ATIVA=0
URNA_DAILY_GLOBAL_SATS=500
URNA_POT_RESERVE_SATS=500
# Com o bot do Telegram configurado, avisa a cada voto (até 30 avisos por hora). 0 desliga.
URNA_TELEGRAM_VOTOS=1

# ---------- Recompensas ----------
# sats de cada imagem do dia, em ordem (1ª, 2ª...). A soma é o máximo por pessoa
# por dia, contado por endereço Lightning e por IP. 10,11 = 21 sats por dia.
REWARD_SCHEDULE=10,11
# máximo que o site paga por dia (inclui taxas)
DAILY_GLOBAL_SATS=1000
# para de pagar quando o pote chega nisso
POT_RESERVE_SATS=500
# folga de taxa considerada nos limites
MAX_FEE_SATS=2
# Pagar também endereços de fora da Coinos (via LNURL). Deixe 0: a API da Coinos
# não aceita teto de taxa, então uma invoice com rota cara pode custar caro ao pote.
# Se ligar, o servidor pausa sozinho os pagamentos externos ao ver uma taxa acima de MAX_FEE_SATS.
ALLOW_EXTERNAL_PAYOUTS=0
# Pagamentos sem confirmação da Coinos no mesmo dia; ao chegar nisso, as recompensas
# pausam até o dia seguinte (para você conferir na Coinos).
MAX_PAYOUT_ERRORS_PER_DAY=5
# Dias que os resgates concluídos (endereço Lightning + hash do IP) ficam guardados
RETENTION_DAYS=30
# intervalo mínimo entre resgates do mesmo IP
MIN_CLAIM_INTERVAL_S=20
# tempo para resgatar depois de exportar (s)
CLAIM_TOKEN_TTL_S=1800

# ---------- Anti-abuso ----------
# dificuldade da prova de trabalho (cada +1 dobra o tempo)
POW_BITS=19
# Obrigatórios com recompensas ligadas. Gere cada um com: openssl rand -hex 32
POW_HMAC_KEY=
IP_SALT=
# exportações por IP a cada 10 minutos
EXPORTS_PER_10MIN=10

# ---------- Renderização ----------
# 3840 = 4K; 7680 = 8K (precisa de ~2 GB de RAM por render)
MAX_EXPORT_WIDTH=3840
PREVIEW_WIDTH=1280
# renders simultâneos
RENDER_WORKERS=1
# pedidos esperando na fila; acima disso o site responde "ocupado"
MAX_RENDER_QUEUE=8
MAX_UPLOAD_MB=8
